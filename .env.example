# DELLA — Сервис подбора грузов для водителей-грузоперевозчиков (Казахстан)

DATABASE_URL="file:./dev.db"
# Для PostgreSQL: "postgresql://postgres:postgres@localhost:5432/della_db?schema=public"
JWT_SECRET="della_kazakhstan_super_secret_jwt_key_2026"
PORT=5000
NODE_ENV=development

# Redis & Очереди BullMQ
REDIS_URL="redis://localhost:6379"

# Настройки телефонии (Провайдеры: mock | twilio | zadarma)
TELEPHONY_PRIMARY_PROVIDER="mock"
TELEPHONY_FALLBACK_PROVIDER="mock"

# Ключи Twilio (при использовании Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Ключи Zadarma (при использовании Zadarma)
ZADARMA_KEY=""
ZADARMA_SECRET=""

# Базовый URL для Webhook (например, ngrok URL для внешних звонков или localhost для тестов)
BASE_WEBHOOK_URL="http://localhost:5000"

# Лимиты от спама и эскалация
ESCALATION_TIMEOUT_MINUTES=10
MAX_CALLS_PER_DRIVER_HOUR=3
